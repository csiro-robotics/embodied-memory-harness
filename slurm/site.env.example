# Site settings for slurm/submit.sh and slurm/arm.slurm.
# Copy to slurm/site.env (git-ignored) and fill in every value.

# Extra sbatch options for your cluster: account, partition, node exclusions.
# Pin the GPU type (e.g. --constraint=L40S) so every arm and replicate runs on the same hardware.
SBATCH_ARGS="--account=<account> --partition=<gpu-partition>"

# Environment modules to load on the compute node, space-separated (empty if none).
# Pin versions (e.g. ollama/0.9.5): a new default version mid-study changes the inference server.
SITE_MODULES=""

# Conda environment name or path (empty = use the python already on PATH).
CONDA_ENV=""

# Where run folders and job logs are written. Must be writable by you.
RUNS=/path/to/runs

# A standard ALFWorld data download (contains json_2.1.1/, logic/, base_config.yaml).
ALFWORLD_SRC=/path/to/alfworld

# The 500 training game folders (train500_v2), used as the train split.
TRAIN500_TASKS=/path/to/train500_v2

# Another training set is chosen when queuing, not here: TRAIN_TASKS=<dir> slurm/submit.sh ...

# A directory YOU can write to, where the job assembles the ALFWorld data layout with symlinks.
ALFWORLD_STAGE=/path/to/alfworld_train500

# Ollama model cache (must already contain qwen3:14b, and nomic-embed-text for kg_hybrid).
OLLAMA_MODELS_DIR=/path/to/ollama-models
